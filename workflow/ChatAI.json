    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Node: Code in JavaScript (Run once for each item)\n//\n// Output akhir untuk Webhook: { reply: \"...\" }\n// Kita ambil text dari AI Agent dengan beberapa kemungkinan struktur.\n\nfunction pickFirstString(...vals) {\n  for (const v of vals) {\n    if (typeof v === 'string' && v.trim().length > 0) return v.trim();\n  }\n  return '';\n}\n\n// Kemungkinan-kemungkinan output dari node AI Agent / model\nconst text =\n  pickFirstString(\n    $json.output,                         // sering dipakai n8n AI Agent\n    $json.answer,                         // kalau kamu set field answer\n    $json.text,                           // kadang output jadi text\n    $json?.message?.content,              // beberapa node model\n    $json?.choices?.[0]?.message?.content,\n    $json?.response?.[0]?.content?.[0]?.text,\n  ) || 'Maaf, terjadi kesalahan.';\n\n// Webapp kamu enaknya cukup baca reply\nreturn {\n  reply: text,\n};\n"
      },
